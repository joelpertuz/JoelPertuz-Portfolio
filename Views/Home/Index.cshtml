@model IEnumerable<JoelPertuzPortfolio.Models.Project>
@{
    ViewData["Title"] = "Joel Pertuz | Full Stack Developer";
    var certifications = ViewBag.Certifications as IEnumerable<JoelPertuzPortfolio.Models.Certification>;
}

<div class="container page-shell">
    <!-- HERO SECTION -->
    <section class="portfolio-hero mb-5">
        <div class="hero-content">
            <span class="hero-eyebrow"><span class="availability-dot"></span> Disponible para oportunidades</span>
            <h1>Hola, soy <span>Joel Pertuz Banda</span></h1>
            <p class="hero-role">Desarrollador Full Stack Jr. <span aria-hidden="true">·</span> Ingeniero de Sistemas</p>
            <p class="hero-summary">Construyo experiencias web útiles y funcionales con .NET, C# y tecnologías modernas.</p>
            <div class="hero-actions">
                <a href="#proyectos" class="btn btn-primary btn-lg">Explorar proyectos <span aria-hidden="true">↓</span></a>
                <a href="#contacto" class="btn btn-outline-light btn-lg">Hablemos <span aria-hidden="true">↗</span></a>
            </div>
        </div>
        <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
        <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>
    </section>

    <!-- SOBRE MÍ -->
    <section id="sobre-mi" class="mb-5">
        <h2 class="section-heading mb-4"><span class="section-number">01</span> Perfil profesional</h2>
        <p class="profile-copy">
            Desarrollador de Software Full Stack Junior con 6 meses de experiencia profesional en desarrollo y mantenimiento de 
            aplicaciones web con C#, .NET Core, ASP.NET, Entity Framework y SQL Server. Experiencia consumiendo y 
            construyendo REST APIs, y trabajando con Git mediante Azure DevOps. Desarrollo de interfaces con Razor, HTML, 
            CSS, JavaScript, Bootstrap y jQuery, así como diseño de modelos relacionales, consultas SQL y procedimientos 
            almacenados. Participación activa en análisis, implementación y pruebas dentro del ciclo de desarrollo de software. 
            Experiencia adicional en proyectos académicos con Python, Flask y TensorFlow/Keras. 
         
        </p>
    </section>

    <!-- HABILIDADES -->
    <section id="habilidades" class="mb-5">
        <h2 class="section-heading mb-4"><span class="section-number">02</span> Stack tecnológico</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card skill-card h-100">
                    <div class="card-body">
                        <span class="skill-label">01 / Lógica</span>
                        <h5 class="card-title">Backend</h5>
                        <p class="card-text">C#, .NET Core, ASP.NET MVC, Entity Framework Core, REST APIs / Web API, Python.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card skill-card h-100">
                    <div class="card-body">
                        <span class="skill-label">02 / Experiencia</span>
                        <h5 class="card-title">Frontend</h5>
                        <p class="card-text">Razor Views, HTML5, CSS3, JavaScript, Leaflet.js, Bootstrap, jQuery, React.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card skill-card h-100">
                    <div class="card-body">
                        <span class="skill-label">03 / Datos y flujo</span>
                        <h5 class="card-title">BD &amp; herramientas</h5>
                        <p class="card-text">SQL Server, Azure DevOps, Git, Postman, VS Code, Visual Studio.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- PROYECTOS DESTACADOS -->
    <section id="proyectos" class="mb-5">
        <h2 class="section-heading mb-4"><span class="section-number">03</span> Proyectos destacados</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var project in Model)
                {
                    <div class="col">
                        <div class="card project-card h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge project-badge">@project.BadgeText</span>
                                    <small class="project-category">@project.Category</small>
                                </div>
                                <h5 class="card-title fw-bold">@project.Title</h5>
                                <p class="card-text flex-grow-1">@project.Summary</p>
                                <div class="mb-3">
                                    <small class="tech-label">Tecnologías</small><br />
                                    <span class="badge tech-badge">@project.Technologies</span>
                                </div>
                                <div class="mt-auto d-flex justify-content-between">
                                    @if (!string.IsNullOrEmpty(project.GithubUrl))
                                    {
                                        <a href="@project.GithubUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-dark">
                                            GitHub <span aria-hidden="true">↗</span>
                                        </a>
                                    }
                                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modal-@project.Id">
                                        Ver Detalle
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Modal de Detalle por Proyecto -->
                    <div class="modal fade" id="modal-@project.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content">
                                <div class="modal-header bg-dark text-white">
                                    <h5 class="modal-title">@project.Title</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="fw-bold text-primary">Categoría: @project.Category</p>
                                    <h6>Descripción Completa:</h6>
                                    <p>@project.FullDescription</p>
                                    <h6>Tecnologías Utilizadas:</h6>
                                    <p><span class="badge bg-dark">@project.Technologies</span></p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p class="empty-state">Los proyectos destacados estarán disponibles próximamente.</p>
                </div>
            }
        </div>
    </section>

    <!-- CERTIFICACIONES -->
    <section id="certificaciones" class="mb-5">
        <h2 class="section-heading mb-4"><span class="section-number">04</span> Certificaciones</h2>
        <div class="list-group certification-list">
            @if (certifications != null && certifications.Any())
            {
                foreach (var cert in certifications)
                {
                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 fw-bold">@cert.Title</h6>
                            <small class="text-muted">@cert.Institution — @cert.DateObtained</small>
                        </div>
                        @if (!string.IsNullOrEmpty(cert.CredentialUrl))
                        {
                            <a href="@cert.CredentialUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">Ver credencial <span aria-hidden="true">↗</span></a>
                        }
                    </div>
                }
            }
            else
            {
                <p class="empty-state mb-0">Las certificaciones se añadirán próximamente.</p>
            }
        </div>
    </section>

    <!-- CONTACTO -->
    <section id="contacto" class="contact-panel mb-5">
        <span class="section-number">05 / CONTACTO</span>
        <h2>¿Construimos algo juntos?</h2>
        <p>Estoy disponible para nuevas oportunidades y colaboraciones en desarrollo de software.</p>
        <div class="contact-details">
            <a class="contact-email" href="mailto:joeljoseper54@gmail.com">joeljoseper54@gmail.com <span aria-hidden="true">↗</span></a>
            <span class="contact-location">Colombia</span>
        </div>
    </section>
</div>