@model IEnumerable<JoelPertuzPortfolio.Models.Project>
@{
    ViewData["Title"] = "Joel Pertuz | Full Stack Developer";
    var certifications = ViewBag.Certifications as IEnumerable<JoelPertuzPortfolio.Models.Certification>;
}

<div class="container py-4">
    <!-- HERO SECTION -->
    <section class="text-center py-5 mb-5 rounded-3 bg-dark text-white p-4 shadow-lg">
        <h1 class="display-4 fw-bold text-primary">Joel Pertuz Banda</h1>
        <p class="lead text-light mb-2">Desarrollador Full Stack Jr. | Ingeniero de Sistemas</p>
        <p class="text-muted small mb-4">Especializado en .NET Core, C#, SQL Server, arquitecturas web MVC/API y desarrollo frontend.</p>
        <div>
            <a href="#proyectos" class="btn btn-primary btn-lg me-2">Ver Proyectos</a>
            <a href="#contacto" class="btn btn-outline-light btn-lg">Contacto</a>
        </div>
    </section>

    <!-- SOBRE MÍ -->
    <section id="sobre-mi" class="mb-5">
        <h2 class="border-bottom pb-2 mb-4 text-dark"><i class="bi bi-person-badge"></i> Perfil Profesional</h2>
        <p class="fs-5 text-secondary">
            Desarrollador de Software Full Stack Junior con 6 meses de experiencia profesional en desarrollo y mantenimiento de 
            aplicaciones web con C#, .NET Core, ASP.NET, Entity Framework y SQL Server. Experiencia consumiendo y 
            construyendo REST APIs, y trabajando con Git mediante Azure DevOps. Desarrollo de interfaces con Razor, HTML, 
            CSS, JavaScript, Bootstrap y jQuery, así como diseño de modelos relacionales, consultas SQL y procedimientos 
            almacenados. Participación activa en análisis, implementación y pruebas dentro del ciclo de desarrollo de software. 
            Experiencia adicional en proyectos académicos con Python, Flask y TensorFlow/Keras. 
         
        </p>
    </section>

    <!-- HABILIDADES -->
    <section id="habilidades" class="mb-5">
        <h2 class="border-bottom pb-2 mb-4 text-dark"><i class="bi bi-tools"></i> Stack Tecnológico</h2>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm bg-light">
                    <div class="card-body">
                        <h5 class="card-title text-primary"><i class="bi bi-server"></i> Backend</h5>
                        <p class="card-text">C#, .NET Core, ASP.NET MVC, Entity Framework Core, REST APIs / Web API, Python[cite: 1].</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm bg-light">
                    <div class="card-body">
                        <h5 class="card-title text-success"><i class="bi bi-layout-text-window-reverse"></i> Frontend</h5>
                        <p class="card-text">Razor Views, HTML5, CSS3, JavaScript, Leaflet.js, Bootstrap[cite: 1, 2].</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm bg-light">
                    <div class="card-body">
                        <h5 class="card-title text-warning"><i class="bi bi-database"></i> BD & Herramientas</h5>
                        <p class="card-text">SQL Server (Consultas avanzadas, Stored Procedures), PostGIS, Git, Postman, VS Code[cite: 1, 2].</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- PROYECTOS DESTACADOS -->
    <section id="proyectos" class="mb-5">
        <h2 class="border-bottom pb-2 mb-4 text-dark"><i class="bi bi-code-slash"></i> Proyectos Destacados</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var project in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-primary">@project.BadgeText</span>
                                    <small class="text-muted">@project.Category</small>
                                </div>
                                <h5 class="card-title fw-bold">@project.Title</h5>
                                <p class="card-text text-secondary flex-grow-1">@project.Summary</p>
                                <div class="mb-3">
                                    <small class="fw-bold text-dark">Tech Stack:</small><br />
                                    <span class="badge bg-secondary">@project.Technologies</span>
                                </div>
                                <div class="mt-auto d-flex justify-content-between">
                                    @if (!string.IsNullOrEmpty(project.GithubUrl))
                                    {
                                        <a href="@project.GithubUrl" target="_blank" class="btn btn-sm btn-outline-dark">
                                            <i class="bi bi-github"></i> GitHub
                                        </a>
                                    }
                                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modal-@project.Id">
                                        Ver Detalle
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Modal de Detalle por Proyecto -->
                    <div class="modal fade" id="modal-@project.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content">
                                <div class="modal-header bg-dark text-white">
                                    <h5 class="modal-title">@project.Title</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="fw-bold text-primary">Categoría: @project.Category</p>
                                    <h6>Descripción Completa:</h6>
                                    <p>@project.FullDescription</p>
                                    <h6>Tecnologías Utilizadas:</h6>
                                    <p><span class="badge bg-dark">@project.Technologies</span></p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </section>

    <!-- CERTIFICACIONES -->
    <section id="certificaciones" class="mb-5">
        <h2 class="border-bottom pb-2 mb-4 text-dark"><i class="bi bi-patch-check"></i> Certificaciones</h2>
        <div class="list-group shadow-sm">
            @if (certifications != null)
            {
                foreach (var cert in certifications)
                {
                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 fw-bold">@cert.Title</h6>
                            <small class="text-muted">@cert.Institution — @cert.DateObtained</small>
                        </div>
                        @if (!string.IsNullOrEmpty(cert.CredentialUrl))
                        {
                            <a href="@cert.CredentialUrl" target="_blank" class="btn btn-sm btn-outline-primary">Ver Credencial</a>
                        }
                    </div>
                }
            }
        </div>
    </section>

    <!-- CONTACTO -->
    <section id="contacto" class="mb-5 text-center p-4 bg-light rounded shadow-sm">
        <h2 class="mb-3">¿Hablamos?</h2>
        <p class="text-muted">Estoy disponible para nuevas oportunidades y colaboraciones en desarrollo de software.</p>
        <p><strong>Email:</strong> <a href="mailto:joeljoseper54@gmail.com">joeljoseper54@gmail.com</a> | <strong>Ubicación:</strong> Colombia</p>
    </section>
</div>